# Database (used by both api and worker containers)
DATABASE_URL=postgresql+asyncpg://callcenter:callcenter@db:5432/callcenter_qa

# Redis (arq broker/job store)
REDIS_URL=redis://redis:6379/0

# Local audio storage path (inside containers)
AUDIO_STORAGE_PATH=/data/audio

# faster-whisper: model | device | compute_type
# WHISPER_MODEL: tiny | base | small | medium | large-v3 (bigger = slower + more accurate)
# WHISPER_DEVICE / WHISPER_COMPUTE_TYPE: "auto" detects a local GPU and picks
#   cuda+float16, otherwise cpu+int8. Override explicitly if you want to force one.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- Local LLM (QA evaluation) -----------------------------------------
# No cloud AI provider is supported. Requires Ollama running locally
# (natively on Windows, or reachable via host.docker.internal from Docker) -
# see README for `ollama pull` instructions.
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_TIMEOUT=300
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_MAX_RETRIES=2

# When true, the app refuses any outbound HTTP request to a non-local host
# (see app/security/offline_guard.py). Keep this true unless you know what
# you're doing - it is the guarantee that no data leaves this machine.
OFFLINE_MODE=true

# --- Auth ----------------------------------------------------------------
# Generate a real secret: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=change-me-in-.env-this-default-is-not-secure
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Comma-separated list of origins allowed to call this API (the frontend URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000
